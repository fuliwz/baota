[Unit]
Description=Baota Linux Panel 7.4.0
After=network.target
[Service]
Type=simple
WorkingDirectory=/www/server/panel
ExecStart=/www/server/panel/pyenv/bin/python /www/server/panel/run_panel.py
Restart=on-failure
RestartSec=5
User=root
UMask=0077
Environment=PYTHONUNBUFFERED=1
[Install]
WantedBy=multi-user.target
